{
  "name": "calorie-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch server/dev.ts",
    "build": "tsx scripts/sync-skill.ts && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "user:create": "tsx scripts/create-user.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"api/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"api/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" \".github/**/*.yml\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "luxon": "3.7.2",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.5",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "prettier": "3.9.8",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "license": "UNLICENSED"
}
